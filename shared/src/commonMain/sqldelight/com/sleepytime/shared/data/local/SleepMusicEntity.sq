import kotlin.Boolean;
import kotlin.Float;

CREATE TABLE SleepMusicEntity (
    musicName TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    category TEXT NOT NULL DEFAULT 'ALL',
    imageName TEXT NOT NULL DEFAULT '',
    duration INTEGER NOT NULL DEFAULT 1800,
    volume REAL AS Float NOT NULL DEFAULT 0.8,

    isFavorite INTEGER AS Boolean NOT NULL DEFAULT 0,
    isLooping INTEGER AS Boolean NOT NULL DEFAULT 1,
    isPremium INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_music_category ON SleepMusicEntity(category);
CREATE INDEX IF NOT EXISTS idx_music_favorite ON SleepMusicEntity(isFavorite);

insertOrIgnoreMusic:
INSERT OR IGNORE INTO SleepMusicEntity VALUES ?;

getAllMusic:
SELECT * FROM SleepMusicEntity;

getMusicByCategory:
SELECT * FROM SleepMusicEntity WHERE category = ?;

getFavoriteMusic:
SELECT * FROM SleepMusicEntity WHERE isFavorite = 1;

toggleFavorite:
UPDATE SleepMusicEntity
SET isFavorite = CASE WHEN isFavorite = 1 THEN 0 ELSE 1 END
WHERE musicName = ?;

getMusicByName:
SELECT * FROM SleepMusicEntity WHERE musicName = ?;