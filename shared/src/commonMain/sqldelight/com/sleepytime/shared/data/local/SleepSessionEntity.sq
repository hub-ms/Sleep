import com.sleepytime.shared.domain.model.EnvironmentFeature;
import com.sleepytime.shared.domain.model.SleepMetrics;
import com.sleepytime.shared.domain.model.SleepStage;
import com.sleepytime.shared.enum_.SleepStageType;
import kotlin.Float;
import kotlin.Int;
import kotlin.collections.List;
import kotlin.collections.Map;
import kotlinx.datetime.LocalDate;

CREATE TABLE SleepSessionEntity (
    sessionId TEXT NOT NULL PRIMARY KEY,
    date TEXT AS LocalDate NOT NULL,

    sleepMetrics TEXT AS SleepMetrics NOT NULL,

    environmentHistory TEXT AS List<EnvironmentFeature.Snapshot> NOT NULL,
    environmentStats TEXT AS EnvironmentFeature.Statistics NOT NULL,
    environmentFlags TEXT AS EnvironmentFeature.Flag NOT NULL,


    awakeMinutes REAL NOT NULL,
    lightMinutes REAL NOT NULL,
    deepMinutes REAL NOT NULL,
    remMinutes REAL NOT NULL,
    targetMinutes REAL NOT NULL,
    sleepLatencyMinutes REAL NOT NULL,
    stageTimeline TEXT AS List<SleepStage> NOT NULL,
    stagesDistribution TEXT AS Map<SleepStageType, Float> NOT NULL,

    wakeCount INTEGER AS Int NOT NULL,
    sleepEfficiency INTEGER AS Int NOT NULL,

    sensorCsv TEXT NOT NULL ,
    environmentCsv TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);
insertSession: INSERT OR REPLACE INTO SleepSessionEntity VALUES ?;
getSessionByDate:
SELECT * FROM SleepSessionEntity
WHERE date = :targetDate
ORDER BY createdAt DESC
LIMIT 1;
getSessionsByDateRange:
SELECT * FROM SleepSessionEntity
WHERE date >= :fromDate AND date <= :toDate
ORDER BY date ASC;

getSessionDatesByMonth:
SELECT date FROM SleepSessionEntity
WHERE date LIKE :yearMonthPattern;

getLatestSession: SELECT * FROM SleepSessionEntity
ORDER BY createdAt DESC
LIMIT 1;
deleteSession: DELETE FROM SleepSessionEntity WHERE sessionId = ?;
